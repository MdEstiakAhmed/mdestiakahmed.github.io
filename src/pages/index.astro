---
import { Image } from 'astro:assets';

import ThemeToggle from '@/components/ThemeToggle';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { nav, profile, projects, stats } from '@/data/site-data';
import avatar from '@/assets/estiak-800.webp';
---

<BaseLayout>
  <header class="mx-auto flex max-w-6xl items-center justify-between px-4 py-6 sm:px-6">
    <a href="/" class="font-semibold tracking-tight">
      {profile.name}
    </a>
    <nav aria-label="Primary" class="hidden gap-6 text-sm text-muted-foreground md:flex">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-foreground">
          {item.label}
        </a>
      ))}
    </nav>
    <ThemeToggle client:load />
  </header>

  <main class="mx-auto max-w-6xl px-4 sm:px-6">
    <section id="home" class="grid items-center gap-10 py-16 md:grid-cols-[1fr_auto] md:py-28">
      <div class="space-y-6">
        {profile.availability.open && (
          <span class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs text-muted-foreground">
            <span class="size-2 rounded-full bg-emerald-500" />
            {profile.availability.label}
          </span>
        )}
        <h1 class="text-4xl font-bold tracking-tight sm:text-6xl">{profile.name}</h1>
        <p class="text-xl text-primary sm:text-2xl">{profile.title}</p>
        <p class="max-w-xl text-muted-foreground">{profile.tagline}</p>
        <div class="flex flex-wrap gap-3">
          <a
            href="#projects"
            class="rounded-full bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground"
          >
            View projects
          </a>
          <a
            href={profile.cv}
            target="_blank"
            rel="noopener"
            class="rounded-full border px-5 py-2.5 text-sm font-medium hover:bg-accent"
          >
            Download CV
          </a>
        </div>
      </div>
      <Image
        src={avatar}
        alt={`Portrait of ${profile.name}`}
        width={320}
        height={320}
        loading="eager"
        class="size-56 rounded-full object-cover sm:size-72"
      />
    </section>

    <section aria-label="Stats" class="grid grid-cols-3 gap-4 border-y py-10 text-center">
      {stats.map((s) => (
        <div>
          <p class="text-3xl font-bold">{s.value()}</p>
          <p class="text-sm text-muted-foreground">{s.label}</p>
        </div>
      ))}
    </section>

    <section id="projects" class="py-16">
      <h2 class="mb-8 text-2xl font-semibold">Projects</h2>
      <ul class="grid gap-6 md:grid-cols-3">
        {projects.map((p) => (
          <li class="overflow-hidden rounded-xl border bg-card">
            <Image src={p.image.light} alt={`${p.title} logo`} class="block dark:hidden" />
            <Image src={p.image.dark} alt="" aria-hidden="true" class="hidden dark:block" />
            <div class="space-y-2 p-5">
              <h3 class="font-semibold">{p.title}</h3>
              <p class="text-sm text-muted-foreground">{p.summary}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>

  <footer class="mx-auto max-w-6xl px-4 py-10 text-sm text-muted-foreground sm:px-6">
    © {new Date().getFullYear()} {profile.name}
  </footer>
</BaseLayout>
