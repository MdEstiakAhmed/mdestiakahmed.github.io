---
import { cn } from '@/lib/utils';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  class?: string;
}

const { id, eyebrow, title, class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class={cn('scroll-mt-24 py-20 md:py-28', className)}
>
  <header class="mb-12 max-w-2xl space-y-2">
    <p class="text-sm font-medium tracking-widest text-primary uppercase">{eyebrow}</p>
    <h2 id={`${id}-title`} class="text-3xl font-bold tracking-tight sm:text-4xl">
      {title}
    </h2>
  </header>
  <slot />
</section>
