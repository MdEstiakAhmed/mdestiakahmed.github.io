---
import Section from '@/components/ui/Section.astro';
import { education } from '@/data/site-data';
---

<Section id="education" eyebrow="Education" title="Studies">
  <ul class="divide-y rounded-2xl border bg-card">
    {education.map((e) => (
      <li class="flex flex-col gap-1 p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-medium">{e.credential}</p>
          <p class="text-sm text-muted-foreground">{e.institute}</p>
        </div>
        <p class="text-sm text-muted-foreground">
          {e.start} – {e.end}
        </p>
      </li>
    ))}
  </ul>
</Section>
