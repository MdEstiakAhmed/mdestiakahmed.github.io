---
import Section from '@/components/ui/Section.astro';
import { skills } from '@/data/site-data';

// One hue per group (oklch degrees): blue (brand), teal, amber, coral, rose.
const hues = [255, 175, 80, 28, 350];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Section id="skills" eyebrow="Skills" title="What I work with" class="px-4 py-0 sm:px-6 md:py-0">
  <!-- Scroll story: the track is tall, the stage pins, and the code frames play as you scroll.
       Without JS or with reduced motion the track stays a plain, fully visible grid. -->
  <div id="skills-track" class="sk-track" style={`--sk-steps: ${skills.length}`}>
    <div class="sk-stage">
      <canvas class="sk-canvas" aria-hidden="true"></canvas>
      <div class="sk-shade" aria-hidden="true"></div>

      <ol class="sk-rail" aria-hidden="true">
        {skills.map((g, gi) => (
          <li class="sk-rail-item" style={`--h: ${hues[gi % hues.length]}`}>
            <span class="sk-rail-dot"></span>
            <span class="sk-rail-label">{g.group}</span>
          </li>
        ))}
      </ol>

      <div class="sk-panels">
        {skills.map((g, gi) => (
          <article class="sk-panel" style={`--h: ${hues[gi % hues.length]}`}>
            <h3 class="sk-title">{g.group}</h3>
            <ul class="sk-chips" aria-label={`${g.group} skills`}>
              {g.items.map((item) => (
                <li class="sk-chip">
                  <span class="sk-dot" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
            <span class="sk-count" aria-hidden="true">
              {pad(g.items.length)}
            </span>
          </article>
        ))}
      </div>

    </div>
  </div>
</Section>

<script>
  import '@/scripts/skills-sequence';
</script>

<style>
  /* The stage is always dark: it sits on code footage, in both themes. */
  .sk-stage {
    --ink: oklch(0.97 0.005 250);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 1.75rem;
    color: var(--ink);
    background:
      radial-gradient(40rem 20rem at 85% 0%, oklch(0.32 0.08 255 / 0.55), transparent 70%),
      oklch(0.15 0.01 250);
  }
  .sk-canvas,
  .sk-shade {
    display: none;
  }

  /* Section still gets a text gutter (px-4 sm:px-6) for the eyebrow/title; break the
     track out of it so the stage itself reaches the viewport edges. */
  .sk-track {
    width: calc(100% + 2rem);
    margin-inline: -1rem;
  }
  @media (min-width: 640px) {
    .sk-track {
      width: calc(100% + 3rem);
      margin-inline: -1.5rem;
    }
  }

  /* Static layout (no JS, reduced motion): every group visible in a grid. */
  .sk-panels {
    display: grid;
    gap: 2rem 1.5rem;
    padding: 1.5rem;
  }
  .sk-rail {
    display: none;
  }
  @media (min-width: 640px) {
    .sk-panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 2.5rem;
    }
  }

  .sk-panel {
    --tint: oklch(0.76 0.14 var(--h));
    min-width: 0;
  }
  .sk-title {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .sk-count {
    display: block;
    margin-top: 1.25rem;
    font-size: 4rem;
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--tint);
  }
  .sk-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sk-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid color-mix(in oklab, var(--tint) 40%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--tint) 14%, oklch(0.15 0.01 250 / 0.6));
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .sk-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-radius: 999px;
    background: var(--tint);
    box-shadow: 0 0 0.5rem var(--tint);
  }

  /* Live: pinned stage over the playing frames, one group at a time. */
  .sk-track[data-live] {
    --sk-pin: 4.5rem; /* keeps rail/panel text clear of the sticky header */
    height: calc(100svh + var(--sk-steps) * 165svh);
  }
  .sk-track[data-live] .sk-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    border: none;
    border-radius: 0;
    /* Iris wipe: a dot opens into a full circle over the first 8% of the pinned scroll,
       and closes back to a dot over the last 8% — driven by the scroll progress the
       sequence script already writes to --sk-progress on the track. */
    --sk-iris: min(
      calc(var(--sk-progress, 0) / 0.08),
      calc((1 - var(--sk-progress, 0)) / 0.08),
      1
    );
    clip-path: circle(calc(var(--sk-iris) * 120vmax) at 50% 50%);
  }
  .sk-track[data-live] .sk-canvas {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .sk-track[data-live] .sk-shade {
    display: block;
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        0deg,
        oklch(0.12 0.01 250 / 0.92),
        oklch(0.12 0.01 250 / 0.25) 55%,
        transparent
      ),
      linear-gradient(90deg, oklch(0.12 0.01 250 / 0.7), transparent 70%);
  }
  .sk-track[data-live] .sk-panels {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    justify-items: center;
    gap: 0;
    padding: 1.5rem;
  }
  .sk-track[data-live] .sk-panel {
    grid-area: 1 / 1;
    width: 100%;
    max-width: 38rem;
    margin-inline: auto;
    opacity: 0;
    transform: translateX(3rem);
    transition:
      opacity 500ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 500ms cubic-bezier(0.23, 1, 0.32, 1);
    pointer-events: none;
  }
  .sk-track[data-live] .sk-panel[data-active] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .sk-track[data-live] .sk-panel[data-past] {
    transform: translateX(-3rem);
  }
  .sk-track[data-live] .sk-title {
    text-align: center;
  }
  .sk-track[data-live] .sk-count {
    font-size: 5rem;
    text-align: center;
  }
  .sk-track[data-live] .sk-chips {
    justify-content: center;
  }

  .sk-track[data-live] .sk-rail {
    position: absolute;
    top: calc(var(--sk-pin) + 1rem);
    left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .sk-rail-item {
    --tint: oklch(0.76 0.14 var(--h));
    display: flex;
    align-items: center;
    gap: 0.6rem;
    opacity: 0.65;
    transition: opacity 300ms;
  }
  .sk-rail-item[data-active] {
    opacity: 1;
  }
  .sk-rail-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--tint);
  }
  .sk-rail-item[data-active] .sk-rail-dot {
    box-shadow: 0 0 0.75rem var(--tint);
  }
  @media (max-width: 639px) {
    .sk-rail-label {
      display: none;
    }
    .sk-track[data-live] {
      height: calc(100svh + var(--sk-steps) * 120svh);
    }
  }

  @media (min-width: 1024px) {
    .sk-track[data-live] .sk-panels {
      padding: 3rem 3.5rem;
    }
    .sk-track[data-live] .sk-title {
      font-size: 2.25rem;
    }
    .sk-track[data-live] .sk-count {
      font-size: 7rem;
    }
    .sk-track[data-live] .sk-chips {
      gap: 0.75rem;
    }
    .sk-track[data-live] .sk-chip {
      padding: 0.6rem 1.15rem;
      font-size: 1rem;
    }
  }

  /* Print: drop the pin and the footage, show every group on white. */
  @media print {
    .sk-track[data-live] {
      height: auto;
    }
    .sk-track[data-live] .sk-stage {
      --ink: oklch(0.2 0.01 250);
      position: static;
      height: auto;
      border-color: var(--border);
      background: none;
      clip-path: none;
    }
    .sk-track[data-live] .sk-canvas,
    .sk-track[data-live] .sk-shade,
    .sk-track[data-live] .sk-rail {
      display: none;
    }
    .sk-track[data-live] .sk-panels {
      position: static;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
      padding: 1.5rem;
    }
    .sk-track[data-live] .sk-panel {
      max-width: none;
      opacity: 1;
      transform: none;
    }
    .sk-track[data-live] .sk-chip {
      background: none;
    }
  }
</style>
