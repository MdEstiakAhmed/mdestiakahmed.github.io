---
import {
  AppWindow,
  Component,
  LifeBuoy,
  MonitorSmartphone,
  Plug,
  Smartphone,
  type LucideIcon,
} from 'lucide-react';

import Section from '@/components/ui/Section.astro';
import { services } from '@/data/site-data';

const icons: Record<string, LucideIcon> = {
  app: AppWindow,
  components: Component,
  api: Plug,
  pwa: Smartphone,
  responsive: MonitorSmartphone,
  support: LifeBuoy,
};
---

<Section id="services" eyebrow="Services" title="How I can help">
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {services.map((s, i) => {
      const Icon = icons[s.icon] ?? AppWindow;
      return (
        <li class="relative rounded-2xl border bg-card p-6">
          <span class="absolute top-5 right-6 text-sm font-medium text-muted-foreground/60">
            {String(i + 1).padStart(2, '0')}
          </span>
          <Icon className="mb-5 size-8 text-primary" strokeWidth={1.5} aria-hidden="true" />
          <h3 class="mb-2 font-semibold">{s.title}</h3>
          <p class="text-sm text-muted-foreground">{s.description}</p>
        </li>
      );
    })}
  </ul>
</Section>
