---
import { MessageCircle } from 'lucide-react';

import { socials, type Social } from '@/data/site-data';
import { brandIcons } from '@/lib/brand-icons';
import { cn } from '@/lib/utils';

interface Props {
  only?: Social['id'][];
  class?: string;
}

const { only, class: className } = Astro.props;
const items = only ? socials.filter((s) => only.includes(s.id)) : socials;
---

<ul class={cn('flex flex-wrap items-center gap-2', className)}>
  {items.map((s) => {
    const icon = brandIcons[s.id];
    return (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={s.label}
          class="inline-flex size-10 items-center justify-center rounded-full border text-muted-foreground transition-colors hover:border-primary hover:text-primary"
        >
          {icon ? (
            <svg viewBox={icon.viewBox} class="size-4" fill="currentColor" aria-hidden="true">
              {icon.paths.map((d) => (
                <path d={d} fill-rule="evenodd" clip-rule="evenodd" />
              ))}
            </svg>
          ) : (
            <MessageCircle className="size-4" aria-hidden="true" />
          )}
        </a>
      </li>
    );
  })}
</ul>
